# ── Auth0 (provision with: stripe projects add auth0/client) ────────────────
AUTH0_DOMAIN=            # tenant.us.auth0.com — no scheme
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=            # openssl rand -hex 32 (you generate this yourself)
# Port 3100. Port 3000 belongs to the Buzz relay on this machine.
APP_BASE_URL=http://localhost:3100

# ── Stripe payments (test mode — set by hand, Projects does not write these) ─
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # printed by `stripe listen`

# Durable payment state (webhook idempotency + receipt state). Defaults to
# .data/tend-payments.sqlite; override to relocate the SQLite file.
#TEND_PAYMENT_DB_PATH=

# ── Stripe Connect destination charges (scaffold — default OFF) ─────────────
# Set to 1 to switch checkout from direct charges (session created on the
# tribe's connected account) to destination charges (platform charge with a
# full transfer to the tribe). Test mode only; see lib/connect.ts.
#TEND_CONNECT_DESTINATION_CHARGES=1

# ── Tempo Moderato receipt destination ────────────────────────────────────────
# Public testnet address only. One shared address or an override per program.
TEND_TEMPO_RECIPIENT=
TEND_TEMPO_RECIPIENT_RAMAYTUSH=
TEND_TEMPO_RECIPIENT_MUWEKMA=

# ── Tribe connected accounts (printed by: node scripts/setup-connect.mjs) ───
# Leave unset to fall back to platform-account mode with per-tribe metadata.
TEND_ACCT_RAMAYTUSH=
TEND_ACCT_MUWEKMA=

# ── Tribe dashboard access ───────────────────────────────────────────────────
# Production path: Auth0 Organization ids. Hackathon path: email allowlists.
TEND_ORG_RAMAYTUSH=
TEND_ORG_MUWEKMA=
TEND_ADMINS_RAMAYTUSH=you@example.com
TEND_ADMINS_MUWEKMA=you@example.com

# ── MPP (Machine Payments Protocol) ──────────────────────────────────────────
# Optional: a Stripe profile id (profile_test_...) enables the card/SPT method.
# Without it the MPP endpoint offers the Tempo testnet stablecoin method only.
STRIPE_PROFILE_ID=

# ── Local demo switches ──────────────────────────────────────────────────────
# TEND_DEMO=1 walks the prototype with no Stripe key and no charges.
#TEND_DEMO=1
#
# TEND_DEMO_AUTH_BYPASS=1 skips sign-in so the flow can be recorded without an
# Auth0 tenant. It opens checkout and Stripe Connect onboarding to anyone who
# reaches them, so it is honored on a local machine only: the code refuses it
# whenever VERCEL is set, including preview deployments, whose URLs are public.
# Never rely on it as a way to demo a deployed build.
#TEND_DEMO_AUTH_BYPASS=1
